# AURA Studio — environment template
# Copy to .env and fill in. Generate secrets with `openssl rand -base64 32`

# SQLite database file (created by `bun run db:push`).
# Relative paths resolve from prisma/schema.prisma, hence the ../db/ prefix.
DATABASE_URL=file:../db/custom.db

# Session HMAC secret — REQUIRED in production. Derives the fingerprint
# stored server-side; rotating it invalidates all sessions.
#SESSION_SECRET=set-me-openssl-rand-base64-32
SESSION_SECRET="R3GREjiBSxmy+HQVzXk3IMKAHmNdO0I0wT4GpMvvVVA="

# Canonical public origin (sitemap URLs, OpenGraph metadataBase, reset-link
# fallback). Set to your deployed origin in production.
NEXT_PUBLIC_SITE_URL=https://fitness-studio.jesspete.shop
SITE_URL=https://fitness-studio.jesspete.shop

# Transactional email (password-reset links) via Resend. When RESEND_API_KEY
# is unset, reset links are logged server-side (operator channel) — the dev
# setup. AURA_EMAIL_FROM must be a verified Resend sender in production.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# AURA_EMAIL_FROM=AURA Studio <hello@yourdomain.com>
